# Allow-list contexts: private/untracked data never enters either build.
**
!backend/
!backend/app/
!backend/app/**
!backend/alembic/
!backend/alembic/**
!backend/alembic.ini
!backend/requirements.txt
!backend/tests/
!backend/tests/*.py
!frontend/
!frontend/src/
!frontend/src/**
!frontend/public/
!frontend/public/**
!frontend/index.html
!frontend/package.json
!frontend/pnpm-lock.yaml
!frontend/tsconfig*.json
!frontend/vite.config.ts
!docker/
!docker/**
!job-publishing-mcp/
!job-publishing-mcp/requirements.txt
!job-publishing-mcp/talenttrace_job_publishing/
!job-publishing-mcp/talenttrace_job_publishing/*.py
!job-publishing-mcp/talenttrace_job_publishing/publishers/
!job-publishing-mcp/talenttrace_job_publishing/publishers/*.py
# Keep exclusions last, including files placed beneath allowed directories.
**/.env*
**/*.env
**/__pycache__
**/*.pyc
**/*.pem
**/*.key
**/*.pdf
**/*.docx
**/*.wav
**/*.mp3
**/*.mp4
**/*.webm
**/*.sql
**/*.dump
**/node_modules
**/.venv
**/.git
**/data
**/uploads
**/transcripts
**/recordings
