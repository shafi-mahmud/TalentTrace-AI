APP_NAME="TalentTrace AI"
ENVIRONMENT=development
API_V1_PREFIX=/api/v1
CORS_ORIGINS=["http://localhost:5173"]

# Application/business/RAG PostgreSQL uses SQLAlchemy asyncpg.
# Apply migrations and seed the demo policy before JD generation.
POSTGRES_DB=talenttrace
POSTGRES_USER=talenttrace
POSTGRES_PASSWORD=replace_with_a_strong_password
DATABASE_URL=postgresql+asyncpg://talenttrace:replace_with_a_strong_password@localhost:5432/talenttrace

# Separate database on the same PostgreSQL instance; provision it explicitly.
# Optional at startup. Use postgresql:// for Psycopg, not postgresql+asyncpg://.
# LANGGRAPH_CHECKPOINT_DATABASE_URL=postgresql://talenttrace_checkpoints:replace_with_a_strong_password@localhost:5432/talenttrace_checkpoints?connect_timeout=10

# Implemented Job-description generation configuration. Keep real credentials in .env only.
GROQ_API_KEY=your_groq_api_key_here
LLM_MODEL=openai/gpt-oss-120b

# Set this to the document UUID printed by: python -m app.rag.seed_demo_policy
# Generation requires an explicit stored document; startup does not.
# COMPANY_POLICY_DOCUMENT_ID=<returned_document_uuid>

# Standalone MCP job publisher. Keep the real webhook in ignored local configuration.
DISCORD_WEBHOOK_URL=your_discord_webhook_url_here
# Optional external application form used by published demo jobs.
# Keep the real form URL in ignored .env.
# APPLICATION_FORM_URL=https://docs.google.com/forms/d/e/your_form_id/viewform

# Private native CV intake storage. Relative paths resolve from the repository root.
# Use only synthetic/sample documents in the trusted local demo.
# CV_UPLOAD_ROOT=data/cv_uploads

# Optional Tesseract English language-data directory; resolved only for OCR.
# If omitted, PyMuPDF attempts local discovery. No system software is installed automatically.
# OCR_TESSDATA_PATH=/path/to/tessdata

# Recruiter-only synthetic LiveKit proof. Opt in only in an isolated development DB.
LIVEKIT_SYNTHETIC_DEMO_ENABLED=false
LIVEKIT_URL=wss://your-project.livekit.cloud
LIVEKIT_API_KEY=your_livekit_api_key
LIVEKIT_API_SECRET=your_livekit_api_secret

# Optional FREE-ONLY local CPU captions; default disabled. No automatic download.
# LOCAL_CAPTION_MODEL_PATH=/absolute/path/to/pre-downloaded/whisper-tiny.en
# Keep 120 normally; up to 300 only for an approved isolated synthetic development test.
LOCAL_CAPTION_TEST_DURATION_SECONDS=120

# Synthetic interview mail: disabled until separately approved and configured.
INTERVIEW_EMAIL_ENABLED=false
INTERVIEW_EMAIL_SENDER=
INTERVIEW_EMAIL_RECIPIENTS=[]
INTERVIEW_PUBLIC_ORIGIN=
INTERVIEW_SMTP_HOST=
INTERVIEW_SMTP_PORT=465
INTERVIEW_SMTP_USERNAME=
INTERVIEW_SMTP_PASSWORD=

# Optional text-only storage; requires migration 0013 and both-party consent.
TRANSCRIPT_STORAGE_ENABLED=false
TRANSCRIPT_CLEANUP_INTERVAL_SECONDS=60
