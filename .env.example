APP_NAME="TalentTrace AI"
ENVIRONMENT=development
API_V1_PREFIX=/api/v1
CORS_ORIGINS=["http://localhost:5173"]

# Application/business/RAG PostgreSQL uses SQLAlchemy asyncpg.
# Apply migrations and seed the demo policy before JD generation.
POSTGRES_DB=talenttrace
POSTGRES_USER=talenttrace
POSTGRES_PASSWORD=replace_with_a_strong_password
DATABASE_URL=postgresql+asyncpg://talenttrace:replace_with_a_strong_password@localhost:5432/talenttrace

# Separate database on the same PostgreSQL instance; provision it explicitly.
# Optional at startup. Use postgresql:// for Psycopg, not postgresql+asyncpg://.
# LANGGRAPH_CHECKPOINT_DATABASE_URL=postgresql://talenttrace_checkpoints:replace_with_a_strong_password@localhost:5432/talenttrace_checkpoints?connect_timeout=10

# Implemented Job-description generation configuration. Keep real credentials in .env only.
GROQ_API_KEY=your_groq_api_key_here
LLM_MODEL=openai/gpt-oss-120b

# Set this to the document UUID printed by: python -m app.rag.seed_demo_policy
# Generation requires an explicit stored document; startup does not.
# COMPANY_POLICY_DOCUMENT_ID=<returned_document_uuid>
