APP_NAME="TalentTrace AI"
ENVIRONMENT=development
API_V1_PREFIX=/api/v1
CORS_ORIGINS=["http://localhost:5173"]

# PostgreSQL placeholders for future database work
POSTGRES_DB=talenttrace
POSTGRES_USER=talenttrace
POSTGRES_PASSWORD=replace_with_a_strong_password
DATABASE_URL=postgresql+asyncpg://talenttrace:replace_with_a_strong_password@localhost:5432/talenttrace

# Separate database on the same PostgreSQL instance; provision it explicitly.
# Optional at startup. Use postgresql:// for Psycopg, not postgresql+asyncpg://.
# LANGGRAPH_CHECKPOINT_DATABASE_URL=postgresql://talenttrace_checkpoints:replace_with_a_strong_password@localhost:5432/talenttrace_checkpoints?connect_timeout=10

# Planned LLM configuration. Keep real credentials in .env only.
GROQ_API_KEY=your_groq_api_key_here
LLM_MODEL=openai/gpt-oss-120b
